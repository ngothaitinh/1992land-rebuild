# Copy file này thành .env.local và điền ID thật

# GA4 — lấy tại Google Analytics > Admin > Data Streams
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Ads — lấy tại Google Ads > Tools > Tag Setup
NEXT_PUBLIC_GADS_ID=AW-XXXXXXXXX

# Meta Pixel — lấy tại Meta Events Manager
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX

# Web3Forms — đăng ký tại web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Telegram — bot token từ @BotFather, CHAT_ID là id chat của anh Thọ với bot
# Dùng cho: notify, inbox (nhận nội dung), preview + decision (duyệt đăng)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub OAuth App — tạo tại github.com/settings/applications/new
# Application name: 1992 Land CMS
# Homepage URL: https://1992land.com
# Authorization callback URL: https://1992land.com/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Deploy Cloudflare Pages cần đăng nhập wrangler MỘT LẦN trên máy:
#   pnpm dlx wrangler login
# Sau đó đăng web bằng: pnpm deploy  (build + wrangler pages deploy out)
