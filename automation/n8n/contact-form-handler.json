{
  "name": "1992land — Contact Form Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "contact-form",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://1992land.com"
        }
      },
      "id": "node-webhook",
      "name": "Webhook: Contact Form",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "contact-form-1992land"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\n\nconst now = new Date().toLocaleString('vi-VN', {\n  timeZone: 'Asia/Ho_Chi_Minh',\n  dateStyle: 'short',\n  timeStyle: 'short'\n});\n\nconst project = body.du_an_quan_tam || '—';\nconst email   = body.email          || '—';\nconst note    = body.loi_nhan       || '—';\nconst page    = body.source_url     || '1992land.com';\n\nconst message =\n  `📋 *LEAD MỚI — 1992land.com*\\n\\n` +\n  `👤 *${body.ho_ten}*\\n` +\n  `📞 ${body.so_dien_thoai}\\n` +\n  `📧 ${email}\\n` +\n  `🏠 ${project}\\n` +\n  `💬 ${note}\\n\\n` +\n  `🔗 ${page}\\n` +\n  `⏰ ${now}`;\n\nreturn {\n  message,\n  'Thoi gian': now,\n  'Ho ten': body.ho_ten,\n  'Dien thoai': body.so_dien_thoai,\n  'Email': email,\n  'Du an quan tam': project,\n  'Loi nhan': note,\n  'Trang nguon': page\n};"
      },
      "id": "node-format",
      "name": "Code: Format Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "node-telegram",
      "name": "Telegram: Notify Tho",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [680, 180]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "PASTE_YOUR_SHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "node-sheets",
      "name": "Google Sheets: Log Lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [680, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"success\":true}",
        "options": {}
      },
      "id": "node-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook: Contact Form": {
      "main": [
        [{ "node": "Code: Format Lead", "type": "main", "index": 0 }]
      ]
    },
    "Code: Format Lead": {
      "main": [
        [
          { "node": "Telegram: Notify Tho", "type": "main", "index": 0 },
          { "node": "Google Sheets: Log Lead", "type": "main", "index": 0 }
        ]
      ]
    },
    "Telegram: Notify Tho": {
      "main": [
        [{ "node": "Respond to Webhook", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
