# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!scripts/tg-bot/.env.example

# OAuth config (contains secrets — NEVER commit)
public/auth/config.php

# Telegram inbox staging
content-inbox/

# Telegram offset state
scripts/.tg-offset.json

# vercel
.vercel

# local dev logs
dev.log
dev-err.log

# Claude Code internal
.agents/
.claude/
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts


# Telegram bot runtime files
scripts/tg-bot/.env
scripts/tg-bot/.tg-processed.json

# Brainstorm visual companion (local only)
.superpowers/brainstorm/

# Regression baseline directory
.regression-baseline/
